{
  "maxReviewIterations": 3,
  "maxVerdictFormatRetries": 1,
  "claude": {
    "command": "claude",
    "timeoutMs": 900000,
    "analysisTools": "Read,Grep,Glob,mcp__bothread__join_session,mcp__bothread__get_room_state,mcp__bothread__send_message,mcp__bothread__record_note,mcp__bothread__leave_session",
    "implementationTools": "Read,Edit,Write,Grep,Glob,mcp__bothread__join_session,mcp__bothread__get_room_state,mcp__bothread__send_message,mcp__bothread__record_note,mcp__bothread__leave_session",
    "bothreadCommunicationTools": "mcp__bothread__join_session,mcp__bothread__get_room_state,mcp__bothread__send_message,mcp__bothread__record_note,mcp__bothread__leave_session"
  },
  "codex": {
    "command": "codex",
    "timeoutMs": 900000,
    "analysisSandbox": "read-only",
    "reviewSandbox": "read-only",
    "bothreadCommunicationTools": [
      "join_session",
      "get_room_state",
      "send_message",
      "record_note",
      "leave_session"
    ]
  },
  "bothread": {
    "url": "http://127.0.0.1:4889/mcp",
    "apiUrl": "http://127.0.0.1:4889/api",
    "requiredForDevelopment": true,
    "agentName": "Orchestrator V1",
    "brand": "orchestrator"
  },
  "worktree": {
    "lockFile": "orchestrator/runs/.active.lock",
    "allowedPreexistingUntracked": [".bothread/"]
  },
  "verdictMarkers": {
    "accepted": "ORCHESTRATOR_VERDICT: ACCEPTED",
    "changesRequested": "ORCHESTRATOR_VERDICT: CHANGES_REQUESTED"
  },
  "validation": {
    "typeCheckCommand": ["npm", "run", "type-check"],
    "formatCheckCommand": ["npm", "run", "format:check"]
  },
  "forbiddenActionsNote": "The orchestrator never runs git commit, git push, migrations, deploys or credential changes. Claude has no Bash tool in this workflow (Read/Edit/Write/Grep/Glob only), so it cannot invoke them either. Codex only ever runs with --sandbox read-only and is never asked to implement."
}
