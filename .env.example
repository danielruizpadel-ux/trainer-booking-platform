# ============================================
# Supabase Configuration
# ============================================
# Get these from: https://app.supabase.com/project/[project-id]/settings/api

# Public API URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anonymous key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (KEEP SECRET - server only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# Authentication
# ============================================
# Supabase Auth (magic link + Google) usa las mismas variables de arriba.
# Google se configura en el panel de Supabase, no aquí.

# ============================================
# Environment
# ============================================
NODE_ENV=development
